{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnforceTLSRequestsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::clouddrop-media-23871",
        "arn:aws:s3:::clouddrop-media-23871/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "AllowCloudDropAppAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::205839628513:role/clouddrop-ec2-role"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::clouddrop-media-23871",
        "arn:aws:s3:::clouddrop-media-23871/*"
      ]
    }
  ]
}
